   "label": "Copy Photos in Sync",
   "default": "1"
  },
  {
   "fieldname": "refresh_after_sync",
   "fieldtype": "Check",
   "label": "Refresh Device State After Sync",
   "default": "1",
   "description": "Re-read who has what on every device after a sync, so ZK Device User is current. Adds a few minutes."
