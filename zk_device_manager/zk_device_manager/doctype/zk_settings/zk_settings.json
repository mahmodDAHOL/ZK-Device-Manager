   "label": "Scheduled Sync",
   "default": "0",
   "description": "Queue a full sync of every enabled device on the interval below."
  },
  {
   "fieldname": "sync_interval_minutes",
   "fieldtype": "Int",
   "label": "Every (minutes)",
